#!/bin/sh
# include-fragment prints one or more plugin fragments to stdout.
#
# Usage: include-fragment <group>/<name> [<group>/<name> ...]
#
# Each name maps to fragments/<group>/<name>.md under the plugin root.
# Occurrences of ${CLAUDE_PLUGIN_ROOT} in a fragment are replaced with the
# plugin root, so fragments can name scripts by absolute path.
# Exits 1 on an unknown or malformed name, which aborts a skill that
# injects it.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ "$#" -eq 0 ]; then
	echo "usage: include-fragment <group>/<name> [...]" >&2
	exit 2
fi

for name in "$@"; do
	case $name in
	*..* | /* | *[!A-Za-z0-9/_-]*)
		echo "include-fragment: invalid fragment name: $name" >&2
		exit 1
		;;
	esac
	file="$root/fragments/$name.md"
	if [ ! -f "$file" ]; then
		echo "include-fragment: missing fragment $name" >&2
		exit 1
	fi
	sed "s|\${CLAUDE_PLUGIN_ROOT}|$root|g" "$file"
	printf '\n'
done
